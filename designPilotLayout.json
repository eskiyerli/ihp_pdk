      "layer": "TopMetal$1"
    },
    "^TM(\\d)\\.b\\w*$": {
      "cat": "spacing",
      "layer": "TopMetal$1"
    },
    "^Gat\\.[ag]": {
      "cat": "width",
      "layer": "GatPoly"
    },
    "^Gat\\.[bd]": {
      "cat": "spacing",
      "layer": "GatPoly"
    },
    "^Act\\.a": {
      "cat": "width",
