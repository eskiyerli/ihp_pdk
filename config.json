      "callback": "klayoutDRCClick",
      "shortcut": "Ctrl+Shift+D",
      "apply": [
        "layoutEditor"
      ]
    },
    {
      "location": "menuBar",
      "menu": "Check",
      "action": "KLayoutLVS",
      "text": "LVS with KLayout...",
      "module": "klayoutLVS",
      "callback": "klayoutLVSClick",
      "shortcut": "Ctrl+Shift+L",
      "apply": [
        "layoutEditor"
      ]
    },
    {
      "location": "menuBar",
      "menu": "Check",
      "action": "RCExtraction",
      "text": "RC Extraction (PEX)...",
      "module": "pexExtraction",
      "callback": "pexExtractionClick",
      "shortcut": "Ctrl+Shift+X",
      "apply": [
        "layoutEditor"
      ]
    },
    {
      "location": "menuBar",
      "menu": "Edit/Guard Ring",
      "action": "SubstrateTapRing",
      "text": "Substrate Tap (p+)...",
      "module": "guardRing",
      "callback": "guardRingClick",
      "apply": [
        "layoutEditor"
      ]
    }
  ]
