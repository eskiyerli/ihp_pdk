//* NOTE:
//* values are one-sigma deviations (1/3 of min-max)

parameters num_sigmas=1

//* ngspice statistical parameters
parameters mc_rsh_rhigh=gauss(rsh_rhigh_norm,0.0833,num_sigmas)
parameters mc_rsh_rsil=gauss(rsh_rsil_norm,0.0467,num_sigmas)
parameters mc_rsh_rppd=gauss(rsh_rppd_norm,0.033,num_sigmas)
parameters mc_res_area=gauss(res_area_norm,0.033,num_sigmas)
parameters mc_res_rpara=gauss(res_rpara_norm,0.067,num_sigmas)

parameters rsh_rhigh=mc_rsh_rhigh
parameters rsh_rsil=mc_rsh_rsil
parameters rsh_rppd=mc_rsh_rppd
parameters res_area=mc_res_area
parameters res_rpara=mc_res_rpara
