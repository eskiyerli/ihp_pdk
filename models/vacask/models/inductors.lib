//*******************************************************************************
//* inductor2: 2-terminal octagonal spiral inductor (TopMetal2)
//*******************************************************************************
subckt inductor2(plus minus)
parameters w=2u
parameters s=2.1u
parameters d=15.48u
parameters nr_r=1
parameters f_eval=5.0G
parameters m=1

// Process & Stackup Constants (TopMetal2)
parameters r_sq=0.007
parameters h_ox=9.8e-6
parameters eps_0=8.854e-12
parameters eps_ox=3.9 * eps_0
parameters rho_sub=0.1
parameters c_sub_area=1e-6
parameters mu_0=4 * 3.141592653589793 * 1e-7
parameters rho_tm2=r_sq * 3.0e-6

// Geometry (Modified Wheeler for Octagons)
parameters d_out=d + 2 * nr_r * w + 2 * (nr_r - 1) * s
parameters d_avg=0.5 * (d + d_out)
parameters rho_fill=(d_out - d) / (d_out + d)
parameters l_tot=4 * nr_r * d_avg
parameters a_metal=l_tot * w

// Series Inductance & Resistance (with Skin Effect at f_eval)
parameters l_s=2.25 * mu_0 * (nr_r * nr_r) * d_avg / (1 + 3.55 * rho_fill)
parameters delta=sqrt(rho_tm2 / (3.141592653589793 * f_eval * mu_0))
parameters t_eff=3.0e-6 * (1 - exp(-3.0e-6 / delta))
parameters r_s=(rho_tm2 * l_tot) / (w * t_eff)

// Substrate & Oxide Parasitics
parameters c_ox=(eps_ox * a_metal) / h_ox
parameters r_sub=(rho_sub * h_ox) / a_metal
parameters c_sub=c_sub_area * a_metal

// Series branch
l1 (plus 1) sg13g2_default_mod_l l=l_s / m
r1 (1 minus) sg13g2_default_mod_r r=r_s / m

// Port 1 substrate network
cox1 (plus n_sub1) sg13g2_default_mod_c c=c_ox * m / 2
rsub1 (n_sub1 0) sg13g2_default_mod_r r=r_sub / (m * 2)
csub1 (n_sub1 0) sg13g2_default_mod_c c=c_sub * m / 2

// Port 2 substrate network
cox2 (minus n_sub2) sg13g2_default_mod_c c=c_ox * m / 2
rsub2 (n_sub2 0) sg13g2_default_mod_r r=r_sub / (m * 2)
csub2 (n_sub2 0) sg13g2_default_mod_c c=c_sub * m / 2

ends


//*******************************************************************************
//* inductor3: 3-terminal center-tapped octagonal spiral inductor (TopMetal2)
//*******************************************************************************
subckt inductor3(plus minus ct)
parameters w=2u
parameters s=2.1u
parameters d=25.84u
parameters nr_r=2
parameters f_eval=5.0G
parameters m=1

// Process & Stackup Constants (TopMetal2)
parameters r_sq=0.007
parameters h_ox=9.8e-6
parameters eps_0=8.854e-12
parameters eps_ox=3.9 * eps_0
parameters rho_sub=0.1
parameters c_sub_area=1e-6
parameters mu_0=4 * 3.141592653589793 * 1e-7
parameters rho_tm2=r_sq * 3.0e-6

// Geometry (Modified Wheeler for Octagons)
parameters d_out=d + 2 * nr_r * w + 2 * (nr_r - 1) * s
parameters d_avg=0.5 * (d + d_out)
parameters rho_fill=(d_out - d) / (d_out + d)
parameters l_tot=4 * nr_r * d_avg
parameters a_metal=l_tot * w

// Series Inductance & Resistance (with Skin Effect at f_eval)
parameters l_s=2.25 * mu_0 * (nr_r * nr_r) * d_avg / (1 + 3.55 * rho_fill)
parameters delta=sqrt(rho_tm2 / (3.141592653589793 * f_eval * mu_0))
parameters t_eff=3.0e-6 * (1 - exp(-3.0e-6 / delta))
parameters r_s=(rho_tm2 * l_tot) / (w * t_eff)

// Substrate & Oxide Parasitics
parameters c_ox=(eps_ox * a_metal) / h_ox
parameters r_sub=(rho_sub * h_ox) / a_metal
parameters c_sub=c_sub_area * a_metal

// Two symmetric halves
l1 (plus 1) sg13g2_default_mod_l l=0.5 * l_s / m
r1 (1 ct) sg13g2_default_mod_r r=0.5 * r_s / m
l2 (ct 2) sg13g2_default_mod_l l=0.5 * l_s / m
r2 (2 minus) sg13g2_default_mod_r r=0.5 * r_s / m

// Port 1 substrate network
cox1 (plus n_sub1) sg13g2_default_mod_c c=c_ox * m / 2
rsub1 (n_sub1 0) sg13g2_default_mod_r r=r_sub / (m * 2)
csub1 (n_sub1 0) sg13g2_default_mod_c c=c_sub * m / 2

// Port 2 substrate network
cox2 (minus n_sub2) sg13g2_default_mod_c c=c_ox * m / 2
rsub2 (n_sub2 0) sg13g2_default_mod_r r=r_sub / (m * 2)
csub2 (n_sub2 0) sg13g2_default_mod_c c=c_sub * m / 2

ends
