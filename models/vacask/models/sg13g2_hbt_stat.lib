//* NOTE:
//* values are one-sigma deviations (1/3 of min-max)

parameters num_sigmas=1

//* ngspice process variation parameters
parameters mc_vbic_cje=gauss(vbic_cje_norm,0.058,num_sigmas)
parameters mc_vbic_cjc=gauss(vbic_cjc_norm,0.043,num_sigmas)
parameters mc_vbic_cjcp=gauss(vbic_cjcp_norm,0.037,num_sigmas)
parameters mc_vbic_is=gauss(vbic_is_norm,0.087,num_sigmas)
parameters mc_vbic_ibei=gauss(vbic_ibei_norm,0.11,num_sigmas)
parameters mc_vbic_re=gauss(vbic_re_norm,0.09,num_sigmas)
parameters mc_vbic_rcx=gauss(vbic_rcx_norm,0.069,num_sigmas)
parameters mc_vbic_rbx=gauss(vbic_rbx_norm,0.041,num_sigmas)
//*.param  mc_vbic_tf   = 'gauss(vbic_tf_norm, 0.037, num_sigmas)'

parameters vbic_cje=mc_vbic_cje
parameters vbic_cjc=mc_vbic_cjc
parameters vbic_cjcp=mc_vbic_cjcp
parameters vbic_is=mc_vbic_is
parameters vbic_ibei=mc_vbic_ibei
parameters vbic_re=mc_vbic_re
parameters vbic_rcx=mc_vbic_rcx
parameters vbic_rbx=mc_vbic_rbx
//*.param  vbic_tf   = mc_vbic_tf

//* pnpMPA device
parameters mc_sgp_mpa_cje=gauss(sgp_mpa_cje_norm,0.015,num_sigmas)
parameters mc_sgp_mpa_cjc=gauss(sgp_mpa_cjc_norm,0.007,num_sigmas)
parameters mc_sgp_mpa_is=gauss(sgp_mpa_is_norm,0.043,num_sigmas)
parameters mc_sgp_mpa_bf=gauss(sgp_mpa_bf_norm,0.079,num_sigmas)
parameters mc_sgp_mpa_re=gauss(sgp_mpa_re_norm,0.016,num_sigmas)
parameters mc_sgp_mpa_rb=gauss(sgp_mpa_rb_norm,0.008,num_sigmas)
parameters mc_sgp_mpa_rc=gauss(sgp_mpa_rc_norm,0.017,num_sigmas)

parameters sgp_mpa_cje=mc_sgp_mpa_cje
parameters sgp_mpa_cjc=mc_sgp_mpa_cjc
parameters sgp_mpa_is=mc_sgp_mpa_is
parameters sgp_mpa_bf=mc_sgp_mpa_bf
parameters sgp_mpa_re=mc_sgp_mpa_re
parameters sgp_mpa_rb=mc_sgp_mpa_rb
parameters sgp_mpa_rc=mc_sgp_mpa_rc
