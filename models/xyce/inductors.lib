*******************************************************************************
* inductor2: 2-terminal octagonal spiral inductor (TopMetal2)
*******************************************************************************
.subckt inductor2 PLUS MINUS
.param w=2u
.param s=2.1u
.param d=15.48u
.param nr_r=1
.param f_eval=5.0G
.param m=1

* Process & Stackup Constants (TopMetal2)
.param R_SQ=0.007
.param H_OX=9.8e-6
.param EPS_0=8.854e-12
.param EPS_OX={3.9 * EPS_0}
.param RHO_SUB=0.1
.param C_SUB_AREA=1e-6
.param MU_0={4 * 3.141592653589793 * 1e-7}
.param RHO_TM2={R_SQ * 3.0e-6}

* Geometry (Modified Wheeler for Octagons)
.param D_OUT={d + 2 * nr_r * w + 2 * (nr_r - 1) * s}
.param D_AVG={0.5 * (d + D_OUT)}
.param RHO_FILL={(D_OUT - d) / (D_OUT + d)}
.param L_TOT={4 * nr_r * D_AVG}
.param A_METAL={L_TOT * w}

* Series Inductance & Resistance (with Skin Effect at f_eval)
.param L_S={2.25 * MU_0 * (nr_r * nr_r) * D_AVG / (1 + 3.55 * RHO_FILL)}
.param DELTA={sqrt(RHO_TM2 / (3.141592653589793 * f_eval * MU_0))}
.param T_EFF={3.0e-6 * (1 - exp(-3.0e-6 / DELTA))}
.param R_S={(RHO_TM2 * L_TOT) / (w * T_EFF)}

* Substrate & Oxide Parasitics
.param C_OX={(EPS_OX * A_METAL) / H_OX}
.param R_SUB={(RHO_SUB * H_OX) / A_METAL}
.param C_SUB={C_SUB_AREA * A_METAL}

* Series branch
L1 PLUS 1 {L_S / m}
R1 1 MINUS {R_S / m}

* Port 1 substrate network
Cox1 PLUS n_sub1 {C_OX * m / 2}
Rsub1 n_sub1 0 {R_SUB / (m * 2)}
Csub1 n_sub1 0 {C_SUB * m / 2}

* Port 2 substrate network
Cox2 MINUS n_sub2 {C_OX * m / 2}
Rsub2 n_sub2 0 {R_SUB / (m * 2)}
Csub2 n_sub2 0 {C_SUB * m / 2}

.ends inductor2


*******************************************************************************
* inductor3: 3-terminal center-tapped octagonal spiral inductor (TopMetal2)
*******************************************************************************
.subckt inductor3 PLUS MINUS CT
.param w=2u
.param s=2.1u
.param d=25.84u
.param nr_r=2
.param f_eval=5.0G
.param m=1

* Process & Stackup Constants (TopMetal2)
.param R_SQ=0.007
.param H_OX=9.8e-6
.param EPS_0=8.854e-12
.param EPS_OX={3.9 * EPS_0}
.param RHO_SUB=0.1
.param C_SUB_AREA=1e-6
.param MU_0={4 * 3.141592653589793 * 1e-7}
.param RHO_TM2={R_SQ * 3.0e-6}

* Geometry (Modified Wheeler for Octagons)
.param D_OUT={d + 2 * nr_r * w + 2 * (nr_r - 1) * s}
.param D_AVG={0.5 * (d + D_OUT)}
.param RHO_FILL={(D_OUT - d) / (D_OUT + d)}
.param L_TOT={4 * nr_r * D_AVG}
.param A_METAL={L_TOT * w}

* Series Inductance & Resistance (with Skin Effect at f_eval)
.param L_S={2.25 * MU_0 * (nr_r * nr_r) * D_AVG / (1 + 3.55 * RHO_FILL)}
.param DELTA={sqrt(RHO_TM2 / (3.141592653589793 * f_eval * MU_0))}
.param T_EFF={3.0e-6 * (1 - exp(-3.0e-6 / DELTA))}
.param R_S={(RHO_TM2 * L_TOT) / (w * T_EFF)}

* Substrate & Oxide Parasitics
.param C_OX={(EPS_OX * A_METAL) / H_OX}
.param R_SUB={(RHO_SUB * H_OX) / A_METAL}
.param C_SUB={C_SUB_AREA * A_METAL}

* Two symmetric halves with mutual coupling
L1 PLUS 1 {0.5 * L_S / m}
R1 1 CT {0.5 * R_S / m}
L2 CT 2 {0.5 * L_S / m}
R2 2 MINUS {0.5 * R_S / m}
K12 L1 L2 0.8

* Port 1 substrate network
Cox1 PLUS n_sub1 {C_OX * m / 2}
Rsub1 n_sub1 0 {R_SUB / (m * 2)}
Csub1 n_sub1 0 {C_SUB * m / 2}

* Port 2 substrate network
Cox2 MINUS n_sub2 {C_OX * m / 2}
Rsub2 n_sub2 0 {R_SUB / (m * 2)}
Csub2 n_sub2 0 {C_SUB * m / 2}

.ends inductor3
